# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Origin used to build magic-link and email-confirmation redirects.
# Leave unset locally (the request host is used); set it on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
